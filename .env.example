# Prefer: bash scripts/setup-env.sh (generates this file with random secrets).
NINESYNC_PORT=3001
NINESYNC_DB_PASSWORD=
NINESYNC_SERVER_SECRET=
NINESYNC_ADMIN_USERNAME=admin
# Initial admin password: minimum 12 characters. Does not reset existing accounts.
NINESYNC_ADMIN_PASSWORD=
# The HTTPS Compose overlay sets this to true automatically.
NINESYNC_COOKIE_SECURE=false
# Only needed with compose.https.yml. Use a hostname, without https:// or a path.
NINESYNC_DOMAIN=
